  "provenance": {
    "attribution": "derived from Sproat & Jaitly (2016) Google TN corpus",
    "builder": "tools/build_abbreviation_priors.py",
    "categories": "spelled when the corpus says the letters one by one (a dotted chain said as written is spelled); as-written when it says the token itself; the lexicon expansion it says; other for anything else",
    "corpus": "google-tn:en_with_types",
    "key": "ICU toLower(en) of the written token, one trailing period removed",
    "license": "CC BY-SA 4.0",
    "locale": "en",
    "normalization": "the corpus writes no variant key with a period, and some keys (st, dr, mr, ...) in lower and upper case only; period is therefore unmeasured, and title case is measured only where the corpus writes it",
    "shards": [
      "output-00000-of-00100",
      "output-00010-of-00100",
      "output-00020-of-00100",
      "output-00030-of-00100",
      "output-00040-of-00100",
      "output-00050-of-00100",
      "output-00060-of-00100",
      "output-00070-of-00100",
      "output-00080-of-00100"
    ],
    "sources": "icukit en_US lexicon surfaces ending in '.', holding a lowercase letter, with no inner '.', folding to more than one letter; and its dotted chains of single letters with an expansion",
    "sub_key": "written case: lower, title, upper; blended toward the key share with strength 5; a case the corpus never writes for a key has no row, and a surface in that case reads the key"
  }
